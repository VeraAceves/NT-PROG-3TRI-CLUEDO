<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="raizMenu" prefHeight="600.0"
	prefWidth="900.0" stylesheets="@MenuInicial.css"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="controlador.InicioController">

	<children>

		<ImageView fx:id="imagenFondo"
			fitHeight="${raizMenu.height}" fitWidth="${raizMenu.width}"
			pickOnBounds="true" preserveRatio="false">

			<image>
				<Image url="@recursos/imagenes/MenuJuego.png" />
			</image>

		</ImageView>

		<VBox alignment="CENTER" spacing="35.0">

			<children>

				<Text fx:id="t_tituloJuego" text="Misterio en el Castillo">
					<font>
						<Font name="Copperplate Gothic Bold" size="56.0" />
					</font>
				</Text>

				<VBox alignment="CENTER" spacing="20.0">

					<children>

						<Button fx:id="btnNueva" text="Nueva Partida"
							onAction="#nuevaPartida" prefHeight="45.0" prefWidth="250.0">

							<font>
								<Font name="Copperplate Gothic Bold" size="16.0" />
							</font>

						</Button>

						<Button fx:id="btnCargar" text="Cargar Partida"
							onAction="#cargarPartida" prefHeight="45.0" prefWidth="250.0">

							<font>
								<Font name="Copperplate Gothic Bold" size="16.0" />
							</font>

						</Button>

						<Button fx:id="btnSalir" text="Salir del juego" onAction="#salir"
							prefHeight="40.0" prefWidth="250.0">

							<font>
								<Font name="Copperplate Gothic Bold" size="16.0" />
							</font>

						</Button>

					</children>

					<VBox.margin>
						<Insets top="20.0" />
					</VBox.margin>

				</VBox>

			</children>

		</VBox>

	</children>

</StackPane>