<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Label?>

<StackPane fx:id="raizMenuPartida" prefHeight="720.0"
	prefWidth="1280.0" stylesheets="@MenuPartida.css"
	xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="controlador.MenuPartidaController">

	<children>

		<ImageView fitHeight="${raizMenuPartida.height}"
			fitWidth="${raizMenuPartida.width}" opacity="0.6" pickOnBounds="true"
			preserveRatio="false">

			<image>
				<Image url="@recursos/imagenes/Piedra.jpg" />
			</image>

		</ImageView>

		<VBox alignment="CENTER" spacing="35.0">

			<padding>
				<Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
			</padding>

			<children>

				<!-- USUARIO -->
				<HBox alignment="CENTER" spacing="20.0">
					<Label fx:id="lblEstado" text="" />

					<children>

						<Text fx:id="t_nombreUsu" text="Nombre de usuario:">
							<font>
								<Font name="Constantia Bold" size="26.0" />
							</font>
						</Text>

						<TextField fx:id="tf_nomUser" prefHeight="45.0"
							prefWidth="320.0" style="-fx-font-size: 18px;" />

						<Button fx:id="btnValidarJugador" text="VALIDAR"
							onAction="#validarNombre" />

					</children>

				</HBox>

				<!-- NIVELES FÁCILES -->
				<VBox alignment="CENTER_LEFT" spacing="10.0">

					<children>

						<Text fx:id="t_facil" text="Fácil:">
							<font>
								<Font name="Constantia Italic" size="30.0" />
							</font>
						</Text>

						<HBox spacing="30.0">

							<children>

								<StackPane>

									<children>

										<ImageView fx:id="im_nivel1" fitHeight="210.0"
											fitWidth="290.0" pickOnBounds="true" preserveRatio="false">
											<image>
												<Image url="@recursos/imagenes/nivel%201.png" />
											</image>
										</ImageView>

										<Button fx:id="b_nivel1" text="Nivel 1"
											onAction="#seleccionarNivel"
											style="-fx-background-color: transparent;" prefHeight="210.0"
											prefWidth="290.0" />

									</children>

								</StackPane>

								<StackPane>

									<children>

										<ImageView fx:id="im_nivel2" fitHeight="210.0"
											fitWidth="290.0" pickOnBounds="true" preserveRatio="false">
											<image>
												<Image url="@recursos/imagenes/nivel%202.png" />
											</image>
										</ImageView>

										<Button fx:id="b_nivel2" text="Nivel 2"
											onAction="#seleccionarNivel"
											style="-fx-background-color: transparent;" prefHeight="210.0"
											prefWidth="290.0" />

									</children>

								</StackPane>

								<StackPane>

									<children>

										<ImageView fx:id="im_nivel3" fitHeight="210.0"
											fitWidth="290.0" pickOnBounds="true" preserveRatio="false">
											<image>
												<Image url="@recursos/imagenes/nivel%203.png" />
											</image>
										</ImageView>

										<Button fx:id="b_nivel3" text="Nivel 3"
											onAction="#seleccionarNivel"
											style="-fx-background-color: transparent;" prefHeight="210.0"
											prefWidth="290.0" />

									</children>

								</StackPane>

							</children>

						</HBox>

						<!-- DIFÍCIL -->
						<Text fx:id="t_dificil" text="Difícil:">
							<font>
								<Font name="Constantia Italic" size="30.0" />
							</font>
						</Text>

						<HBox spacing="30.0">

							<children>

								<StackPane>

									<children>

										<ImageView fx:id="im_nivel4" fitHeight="210.0"
											fitWidth="290.0" pickOnBounds="true" preserveRatio="false">
											<image>
												<Image url="@recursos/imagenes/nivel%204.png" />
											</image>
										</ImageView>

										<Button fx:id="b_nivel4" text="Nivel 4"
											onAction="#seleccionarNivel"
											style="-fx-background-color: transparent;" prefHeight="210.0"
											prefWidth="290.0" />

									</children>

								</StackPane>

								<StackPane>

									<children>

										<ImageView fx:id="im_nivel5" fitHeight="210.0"
											fitWidth="290.0" pickOnBounds="true" preserveRatio="false">
											<image>
												<Image url="@recursos/imagenes/nivel%205.png" />
											</image>
										</ImageView>

										<Button fx:id="b_nivel5" text="Nivel 5"
											onAction="#seleccionarNivel"
											style="-fx-background-color: transparent;" prefHeight="210.0"
											prefWidth="290.0" />

									</children>

								</StackPane>

							</children>

						</HBox>

					</children>

				</VBox>

				<!-- VOLVER -->
				<Button fx:id="b_volver" text="VOLVER" onAction="#volverMenu"
					prefHeight="55.0" prefWidth="158.0" textAlignment="RIGHT">

					<font>
						<Font name="Copperplate Gothic Bold" size="20.0" />
					</font>

				</Button>

			</children>

		</VBox>

	</children>

</StackPane>