<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>

<GridPane hgap="10" vgap="15"
          xmlns="http://javafx.com/javafx/17"
          xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Configuración de Partida"
           GridPane.columnSpan="2"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label text="Nombre jugador:"
           GridPane.rowIndex="1"/>

    <TextField fx:id="txtNombreJugador"
               GridPane.columnIndex="1"
               GridPane.rowIndex="1"/>

    <Button fx:id="btnValidarJugador"
            text="Validar jugador"
            GridPane.columnSpan="2"
            GridPane.rowIndex="2"/>

    <Label fx:id="lblEstadoJugador"
           text=""
           GridPane.columnSpan="2"
           GridPane.rowIndex="3"/>

    <Label text="Selecciona un nivel:"
           GridPane.columnSpan="2"
           GridPane.rowIndex="4"/>

    <Button fx:id="btnNivel1"
            text="Nivel 1"
            GridPane.rowIndex="5"/>

    <Button fx:id="btnNivel2"
            text="Nivel 2"
            GridPane.columnIndex="1"
            GridPane.rowIndex="5"/>

    <Button fx:id="btnNivel3"
            text="Nivel 3"
            GridPane.rowIndex="6"/>

    <Button fx:id="btnNivel4"
            text="Nivel 4"
            GridPane.columnIndex="1"
            GridPane.rowIndex="6"/>

    <Button fx:id="btnNivel5"
            text="Nivel 5"
            GridPane.rowIndex="7"/>

    <Button fx:id="btnNivel6"
            text="Nivel 6"
            GridPane.columnIndex="1"
            GridPane.rowIndex="7"/>

</GridPane>